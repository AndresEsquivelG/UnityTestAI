{
	/*
	 * Compilación de las pruebas.
	 *
	 * El proyecto se empaqueta con webpack, que resuelve los módulos por su
	 * cuenta; las pruebas, en cambio, las ejecuta Node directamente, así que
	 * necesitan módulos CommonJS y la resolución clásica.
	 *
	 * Solo se compila lo que las pruebas ejercitan. El resto de la extensión
	 * depende del editor y de paquetes que solo webpack resuelve.
	 *
	 * `src/prompts` entra porque la foto de los prompts ejercita el constructor
	 * de verdad, no una copia. Ese módulo busca las plantillas en la carpeta
	 * hermana de la suya, así que `npm run test:unit` las copia a
	 * `out-test/prompts` después de compilar.
	 *
	 * De `src/llm` entra solo el cliente de Claude, por la elección de la
	 * configuración de razonamiento según el modelo.
	 */
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"outDir": "out-test",
		"sourceMap": false,
		"esModuleInterop": true
	},
	"include": [
		"src/test/**/*.ts",
		"src/adapters/**/*.ts",
		"src/core/**/*.ts",
		"src/prompts/**/*.ts",
		"src/agents/**/*.ts",
		"src/utils/**/*.ts",
		"src/llm/claude.ts"
	]
}
